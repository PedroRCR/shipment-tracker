      "updated": 1780265904323,
      "link": null,
      "locked": false,
      "text": "API Endpoints:\n\nSHIPMENTS\n- Create shipment - POST \"/shipments\" body Shipment\n- Get all shipments - GET \"/shipments\"\n- Get all supplier shipments - GET \"/shipments/supplier/{supplierId}\"\n\nSHIPMENT EVENT\n- Create Shipment event - POST \"/shipment-event\"\n- Get Shipment event - POST \"/shipment-event/{id}\"",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Endpoints:\n\nSHIPMENTS\n- Create shipment - POST \"/shipments\" body Shipment\n- Get all shipments - GET \"/shipments\"\n- Get all supplier shipments - GET \"/shipments/supplier/{supplierId}\"\n\nSHIPMENT EVENT\n- Create Shipment event - POST \"/shipment-event\"\n- Get Shipment event - POST \"/shipment-event/{id}\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
