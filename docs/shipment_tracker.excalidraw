      "updated": 1780008282598,
      "link": null,
      "locked": false,
      "text": "-- Supplier\nCREATE TABLE supplier (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    name VARCHAR(100) NOT NULL,\n    email VARCHAR(100) NOT NULL UNIQUE,\n    country VARCHAR(50) NOT NULL\n);\n\n-- Users\nCREATE TABLE users (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    email VARCHAR(100) NOT NULL UNIQUE,\n    password VARCHAR(255) NOT NULL,\n    role VARCHAR(20) NOT NULL,\n    supplier_id INT NULL,\n    CONSTRAINT fk_users_supplier FOREIGN KEY (supplier_id) REFERENCES supplier(id)\n);\n\n-- Shipment\nCREATE TABLE shipment (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    tracking_number VARCHAR(20) NOT NULL UNIQUE,\n    origin VARCHAR(100) NOT NULL,\n    destination VARCHAR(100) NOT NULL,\n    weight DECIMAL(10,2) NOT NULL,\n    current_status VARCHAR(20) NOT NULL,\n    supplier_id INT NOT NULL,\n    created_at TIMESTAMP NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMP NOT NULL DEFAULT NOW(),\n    CONSTRAINT fk_shipment_supplier FOREIGN KEY (supplier_id) REFERENCES supplier(id)\n);\n\n-- Shipment Event\nCREATE TABLE shipment_event (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    status_name VARCHAR(20) NOT NULL,\n    occurred_at TIMESTAMP NOT NULL DEFAULT NOW(),\n    shipment_id INT NOT NULL,\n    CONSTRAINT fk_event_shipment FOREIGN KEY (shipment_id) REFERENCES shipment(id)\n);",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Supplier\nCREATE TABLE supplier (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    name VARCHAR(100) NOT NULL,\n    email VARCHAR(100) NOT NULL UNIQUE,\n    country VARCHAR(50) NOT NULL\n);\n\n-- Users\nCREATE TABLE users (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    email VARCHAR(100) NOT NULL UNIQUE,\n    password VARCHAR(255) NOT NULL,\n    role VARCHAR(20) NOT NULL,\n    supplier_id INT NULL,\n    CONSTRAINT fk_users_supplier FOREIGN KEY (supplier_id) REFERENCES supplier(id)\n);\n\n-- Shipment\nCREATE TABLE shipment (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    tracking_number VARCHAR(20) NOT NULL UNIQUE,\n    origin VARCHAR(100) NOT NULL,\n    destination VARCHAR(100) NOT NULL,\n    weight DECIMAL(10,2) NOT NULL,\n    current_status VARCHAR(20) NOT NULL,\n    supplier_id INT NOT NULL,\n    created_at TIMESTAMP NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMP NOT NULL DEFAULT NOW(),\n    CONSTRAINT fk_shipment_supplier FOREIGN KEY (supplier_id) REFERENCES supplier(id)\n);\n\n-- Shipment Event\nCREATE TABLE shipment_event (\n    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    status_name VARCHAR(20) NOT NULL,\n    occurred_at TIMESTAMP NOT NULL DEFAULT NOW(),\n    shipment_id INT NOT NULL,\n    CONSTRAINT fk_event_shipment FOREIGN KEY (shipment_id) REFERENCES shipment(id)\n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
