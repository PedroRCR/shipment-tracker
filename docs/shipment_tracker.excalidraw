      "link": null,
      "locked": false,
      "text": "FindBy{Campo}                          // WHERE campo = ?\nfindBy{Campo}And{Campo}            // WHERE campo1 = ? AND campo2 = ?\nfindBy{Campo}Or{Campo}              // WHERE campo1 = ? OR campo2 = ?\nfindBy{Campo}OrderBy{Campo}Asc  // WHERE campo = ? ORDER BY campo ASC\nfindBy{Campo}Containing              // WHERE campo LIKE %?%\nfindBy{Campo}GreaterThan           // WHERE campo > ?\nfindBy{Campo}LessThan               // WHERE campo < ?\nfindBy{Campo}IsNull                    // WHERE campo IS NULL ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FindBy{Campo}                          // WHERE campo = ?\nfindBy{Campo}And{Campo}            // WHERE campo1 = ? AND campo2 = ?\nfindBy{Campo}Or{Campo}              // WHERE campo1 = ? OR campo2 = ?\nfindBy{Campo}OrderBy{Campo}Asc  // WHERE campo = ? ORDER BY campo ASC\nfindBy{Campo}Containing              // WHERE campo LIKE %?%\nfindBy{Campo}GreaterThan           // WHERE campo > ?\nfindBy{Campo}LessThan               // WHERE campo < ?\nfindBy{Campo}IsNull                    // WHERE campo IS NULL ",
