      "updated": 1780259993452,
      "link": null,
      "locked": false,
      "text": "-- INSERT Suppliers\nINSERT INTO supplier (name, email, country) VALUES\n('DHL Supply Co', 'contact@dhl-supply.com', 'Germany'),\n('Maersk Logistics', 'ops@maersk-logistics.com', 'Denmark'),\n('FedEx Partners', 'info@fedex-partners.com', 'USA'),\n('DB Schenker', 'hello@dbschenker.com', 'Germany'),\n('Kuehne Partner', 'partner@kn-partner.com', 'Switzerland');\n\n-- INSERT Users (passwords are bcrypt of \"password123\")\nINSERT INTO users (email, password, role, supplier_id) VALUES\n('admin@shiptrack.com',   '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'ADMIN',    NULL),\n('admin2@shiptrack.com',  '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'ADMIN',    NULL),\n('dhl@shiptrack.com',     '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'SUPPLIER', 1),\n('maersk@shiptrack.com',  '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'SUPPLIER', 2),\n('fedex@shiptrack.com',   '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'SUPPLIER', 3);\n\n-- INSERT Shipments\nINSERT INTO shipment (tracking_number, origin, destination, weight, current_status, supplier_id, created_at, updated_at) VALUES\n('KN-2026-00001', 'Porto, Portugal',    'Berlin, Germany',    120.50, 'DELIVERED',        1, NOW() - INTERVAL '10 days', NOW() - INTERVAL '2 days'),\n('KN-2026-00002', 'Lisboa, Portugal',   'Copenhagen, Denmark', 45.00, 'IN_TRANSIT',       2, NOW() - INTERVAL '5 days',  NOW() - INTERVAL '1 day'),\n('KN-2026-00003', 'Madrid, Spain',      'New York, USA',      980.00, 'PICKED_UP',        3, NOW() - INTERVAL '3 days',  NOW() - INTERVAL '3 days'),\n('KN-2026-00004', 'Paris, France',      'Hamburg, Germany',   200.75, 'CREATED',          4, NOW() - INTERVAL '1 day',   NOW() - INTERVAL '1 day'),\n('KN-2026-00005', 'Amsterdam, Holland', 'Zurich, Switzerland', 15.30, 'OUT_FOR_DELIVERY', 5, NOW() - INTERVAL '7 days',  NOW()),\n('KN-2026-00006', 'London, UK',         'Porto, Portugal',    330.00, 'FAILED',           1, NOW() - INTERVAL '8 days',  NOW() - INTERVAL '1 day'),\n('KN-2026-00007', 'Berlin, Germany',    'Lisboa, Portugal',    88.90, 'IN_TRANSIT',       2, NOW() - INTERVAL '4 days',  NOW() - INTERVAL '4 days'),\n('KN-2026-00008', 'Rome, Italy',        'Madrid, Spain',      512.00, 'PICKED_UP',        3, NOW() - INTERVAL '2 days',  NOW() - INTERVAL '2 days');\n\n-- INSERT ShipmentEvents\n-- KN-2026-00001 (DELIVERED — full journey)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',          NOW() - INTERVAL '10 days', 1),\n('PICKED_UP',        NOW() - INTERVAL '9 days',  1),\n('IN_TRANSIT',       NOW() - INTERVAL '7 days',  1),\n('OUT_FOR_DELIVERY', NOW() - INTERVAL '3 days',  1),\n('DELIVERED',        NOW() - INTERVAL '2 days',  1);\n\n-- KN-2026-00002 (IN_TRANSIT)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',    NOW() - INTERVAL '5 days', 2),\n('PICKED_UP',  NOW() - INTERVAL '4 days', 2),\n('IN_TRANSIT', NOW() - INTERVAL '1 day',  2);\n\n-- KN-2026-00003 (PICKED_UP)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',   NOW() - INTERVAL '3 days', 3),\n('PICKED_UP', NOW() - INTERVAL '2 days', 3);\n\n-- KN-2026-00004 (CREATED)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED', NOW() - INTERVAL '1 day', 4);\n\n-- KN-2026-00005 (OUT_FOR_DELIVERY)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',          NOW() - INTERVAL '7 days', 5),\n('PICKED_UP',        NOW() - INTERVAL '6 days', 5),\n('IN_TRANSIT',       NOW() - INTERVAL '4 days', 5),\n('OUT_FOR_DELIVERY', NOW(),                      5);\n\n-- KN-2026-00006 (FAILED)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',    NOW() - INTERVAL '8 days', 6),\n('PICKED_UP',  NOW() - INTERVAL '7 days', 6),\n('IN_TRANSIT', NOW() - INTERVAL '5 days', 6),\n('FAILED',     NOW() - INTERVAL '1 day',  6);\n\n-- KN-2026-00007 (IN_TRANSIT)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',    NOW() - INTERVAL '4 days', 7),\n('PICKED_UP',  NOW() - INTERVAL '3 days', 7),\n('IN_TRANSIT', NOW() - INTERVAL '2 days', 7);\n\n-- KN-2026-00008 (PICKED_UP)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',   NOW() - INTERVAL '2 days', 8),\n('PICKED_UP', NOW() - INTERVAL '1 day',  8);",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- INSERT Suppliers\nINSERT INTO supplier (name, email, country) VALUES\n('DHL Supply Co', 'contact@dhl-supply.com', 'Germany'),\n('Maersk Logistics', 'ops@maersk-logistics.com', 'Denmark'),\n('FedEx Partners', 'info@fedex-partners.com', 'USA'),\n('DB Schenker', 'hello@dbschenker.com', 'Germany'),\n('Kuehne Partner', 'partner@kn-partner.com', 'Switzerland');\n\n-- INSERT Users (passwords are bcrypt of \"password123\")\nINSERT INTO users (email, password, role, supplier_id) VALUES\n('admin@shiptrack.com',   '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'ADMIN',    NULL),\n('admin2@shiptrack.com',  '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'ADMIN',    NULL),\n('dhl@shiptrack.com',     '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'SUPPLIER', 1),\n('maersk@shiptrack.com',  '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'SUPPLIER', 2),\n('fedex@shiptrack.com',   '$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi', 'SUPPLIER', 3);\n\n-- INSERT Shipments\nINSERT INTO shipment (tracking_number, origin, destination, weight, current_status, supplier_id, created_at, updated_at) VALUES\n('KN-2026-00001', 'Porto, Portugal',    'Berlin, Germany',    120.50, 'DELIVERED',        1, NOW() - INTERVAL '10 days', NOW() - INTERVAL '2 days'),\n('KN-2026-00002', 'Lisboa, Portugal',   'Copenhagen, Denmark', 45.00, 'IN_TRANSIT',       2, NOW() - INTERVAL '5 days',  NOW() - INTERVAL '1 day'),\n('KN-2026-00003', 'Madrid, Spain',      'New York, USA',      980.00, 'PICKED_UP',        3, NOW() - INTERVAL '3 days',  NOW() - INTERVAL '3 days'),\n('KN-2026-00004', 'Paris, France',      'Hamburg, Germany',   200.75, 'CREATED',          4, NOW() - INTERVAL '1 day',   NOW() - INTERVAL '1 day'),\n('KN-2026-00005', 'Amsterdam, Holland', 'Zurich, Switzerland', 15.30, 'OUT_FOR_DELIVERY', 5, NOW() - INTERVAL '7 days',  NOW()),\n('KN-2026-00006', 'London, UK',         'Porto, Portugal',    330.00, 'FAILED',           1, NOW() - INTERVAL '8 days',  NOW() - INTERVAL '1 day'),\n('KN-2026-00007', 'Berlin, Germany',    'Lisboa, Portugal',    88.90, 'IN_TRANSIT',       2, NOW() - INTERVAL '4 days',  NOW() - INTERVAL '4 days'),\n('KN-2026-00008', 'Rome, Italy',        'Madrid, Spain',      512.00, 'PICKED_UP',        3, NOW() - INTERVAL '2 days',  NOW() - INTERVAL '2 days');\n\n-- INSERT ShipmentEvents\n-- KN-2026-00001 (DELIVERED — full journey)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',          NOW() - INTERVAL '10 days', 1),\n('PICKED_UP',        NOW() - INTERVAL '9 days',  1),\n('IN_TRANSIT',       NOW() - INTERVAL '7 days',  1),\n('OUT_FOR_DELIVERY', NOW() - INTERVAL '3 days',  1),\n('DELIVERED',        NOW() - INTERVAL '2 days',  1);\n\n-- KN-2026-00002 (IN_TRANSIT)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',    NOW() - INTERVAL '5 days', 2),\n('PICKED_UP',  NOW() - INTERVAL '4 days', 2),\n('IN_TRANSIT', NOW() - INTERVAL '1 day',  2);\n\n-- KN-2026-00003 (PICKED_UP)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',   NOW() - INTERVAL '3 days', 3),\n('PICKED_UP', NOW() - INTERVAL '2 days', 3);\n\n-- KN-2026-00004 (CREATED)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED', NOW() - INTERVAL '1 day', 4);\n\n-- KN-2026-00005 (OUT_FOR_DELIVERY)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',          NOW() - INTERVAL '7 days', 5),\n('PICKED_UP',        NOW() - INTERVAL '6 days', 5),\n('IN_TRANSIT',       NOW() - INTERVAL '4 days', 5),\n('OUT_FOR_DELIVERY', NOW(),                      5);\n\n-- KN-2026-00006 (FAILED)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',    NOW() - INTERVAL '8 days', 6),\n('PICKED_UP',  NOW() - INTERVAL '7 days', 6),\n('IN_TRANSIT', NOW() - INTERVAL '5 days', 6),\n('FAILED',     NOW() - INTERVAL '1 day',  6);\n\n-- KN-2026-00007 (IN_TRANSIT)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',    NOW() - INTERVAL '4 days', 7),\n('PICKED_UP',  NOW() - INTERVAL '3 days', 7),\n('IN_TRANSIT', NOW() - INTERVAL '2 days', 7);\n\n-- KN-2026-00008 (PICKED_UP)\nINSERT INTO shipment_event (status_name, occurred_at, shipment_id) VALUES\n('CREATED',   NOW() - INTERVAL '2 days', 8),\n('PICKED_UP', NOW() - INTERVAL '1 day',  8);",
